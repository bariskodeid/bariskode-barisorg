# Reverse proxy production — lihat docs/14-DEPLOYMENT-ORACLE-VM.md &
# docs/13-DEPLOYMENT-CLOUDFLARE.md. Caddy otomatis urus sertifikat HTTPS
# (Let's Encrypt) untuk domain di bawah, selama DNS sudah benar & port
# 80/443 terbuka.

{$DOMAIN} {
    reverse_proxy web:3000
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$CTF_SUBDOMAIN} {
    reverse_proxy ctfd:8000
}
