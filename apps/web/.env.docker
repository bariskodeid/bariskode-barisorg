# Env file untuk Docker deployment (production).
# Dipakai oleh docker-compose — host = "postgres" (nama service Docker).
# JANGAN pakai file ini untuk local dev (pnpm dev).

# --- Payload / Database ---
DATABASE_URI=postgres://bariskode:CHANGE_ME@postgres:5432/bariskode
PAYLOAD_SECRET=CHANGE_ME_32_RANDOM_CHARS

# --- Next.js ---
NEXT_PUBLIC_SERVER_URL=https://bariskode.org

# --- Judge0 ---
JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_API_KEY=

# --- CTFd ---
NEXT_PUBLIC_CTF_URL=https://ctf.bariskode.org

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bariskode.org
