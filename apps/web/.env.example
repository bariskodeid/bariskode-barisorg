# --- Payload / Database ---
# Lokal (pnpm dev di host, lihat docs/07-LOCAL-DEVELOPMENT.md): host
# `localhost` seperti di bawah. Production (jalan di dalam docker network
# yang sama dengan container `postgres`, lihat docs/14-DEPLOYMENT-ORACLE-VM.md
# & infra/docker-compose.yml): GANTI host jadi `postgres` —
# postgres://bariskode:CHANGE_ME@postgres:5432/bariskode. Salah pilih host
# di sini gagalnya ECONNREFUSED, sudah diverifikasi langsung.
DATABASE_URI=postgres://bariskode:CHANGE_ME@localhost:5432/bariskode
PAYLOAD_SECRET=CHANGE_ME_random_string_min_32_chars

# --- Next.js ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Giscus (dari giscus.app setelah aktifkan Discussions di repo, Fase 4) ---
NEXT_PUBLIC_GISCUS_REPO=username/bariskode
NEXT_PUBLIC_GISCUS_REPO_ID=CHANGE_ME
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=CHANGE_ME

# --- Judge0, code sandbox (Fase 5) ---
# Lokal: http://localhost:2358 (Judge0 jalan sebagai container terpisah,
# lihat docs/07-LOCAL-DEVELOPMENT.md). Production: http://judge0-server:2358
# (nama service di docker network yang sama, lihat infra/docker-compose.yml).
JUDGE0_API_URL=http://localhost:2358
# Isi kalau AUTHN_TOKEN di infra/judge0/judge0.conf diisi juga (opsional,
# defense-in-depth). Kosongkan untuk instance self-hosted tanpa auth ekstra.
JUDGE0_API_KEY=

# --- CTFd, lab cybersecurity (Fase 6) ---
# Lokal: http://localhost:8000. Production: https://ctf.bariskode.org
# (subdomain terpisah, lihat docs/12-FEATURE-CYBERSECURITY-LABS.md — auth &
# app CTFd sengaja tidak terhubung dengan Payload).
NEXT_PUBLIC_CTF_URL=http://localhost:8000

# --- Email (opsional, Fase 3+) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bariskode.org
